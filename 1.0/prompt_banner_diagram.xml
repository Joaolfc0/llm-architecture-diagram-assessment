<mxfile host="app.diagrams.net">
  <diagram id="prompt-design" name="Prompt Design">
    <mxGraphModel dx="1024" dy="768" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="Prompt Design for Architecture Quality Assessment" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="20" width="480" height="40" as="geometry"/>
        </mxCell>

        <!-- Left box: LLM-based QA paper -->
        <mxCell id="paper_llm" value="Source A: LLM-based Quality Assessment&#xa;&#xa;\textbf{Paper}&#xa;LLM-based Quality Assessment of Software Architecture Diagrams:&#xa;A Preliminary Study with Four Open-Source Projects&#xa;&#xa;\textbf{Quality Criteria}&#xa;- Clarity&#xa;- Consistency&#xa;- Completeness&#xa;- Accuracy&#xa;- Level of Detail" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="360" height="220" as="geometry"/>
        </mxCell>

        <!-- Right box: Guidelines paper -->
        <mxCell id="paper_guidelines" value="Source B: Diagram Guidelines&#xa;&#xa;\textbf{Paper}&#xa;An Approach to Build Consistent Software Architecture Diagrams&#xa;Using DevOps System Descriptors&#xa;&#xa;\textbf{Empirical Guidelines}&#xa;G1. Elements clearly identified&#xa;G2. Notation clearly defined&#xa;G3. Elements presented in more detail&#xa;G4. Starting/finishing point for reading&#xa;G5. Technology-specific symbols" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="100" width="360" height="240" as="geometry"/>
        </mxCell>

        <!-- Center merge label (optional) -->
        <mxCell id="merge_label" value="Combine&#xa;criteria + guidelines" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#f5f5f5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="260" width="120" height="60" as="geometry"/>
        </mxCell>

        <!-- Bottom box: New Prompt -->
        <mxCell id="new_prompt" value="Result: Guideline-Driven Prompt&#xa;&#xa;\textbf{Prompt Target (example)}&#xa;- Architecture Level of Detail Evaluation&#xa;&#xa;\textbf{From Source A}&#xa;- Uses &quot;Level of Detail&quot; as a quality criterion&#xa;- 4-level rating scale&#xa;&#xa;\textbf{From Source B}&#xa;- Translates G3 (Element Detail) + related ideas&#xa;- Adds explicit guideline checks (YES/NO)&#xa;&#xa;\textbf{Final Prompt Structure}&#xa;- Task + context&#xa;- Evaluation criteria (Element Detail, Interaction Detail, Overall Appropriateness)&#xa;- Rating: [Exemplary | Acceptable | Insufficient | Deficient]&#xa;- Guideline Checks: YES/NO&#xa;- Justification in natural language" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="380" width="520" height="260" as="geometry"/>
        </mxCell>

        <!-- Arrow from LLM paper to merge -->
        <mxCell id="edge_llm_merge" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#000000;" edge="1" parent="1" source="paper_llm" target="merge_label">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Arrow from guidelines paper to merge -->
        <mxCell id="edge_guidelines_merge" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#000000;" edge="1" parent="1" source="paper_guidelines" target="merge_label">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Arrow from merge to new prompt -->
        <mxCell id="edge_merge_prompt" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;strokeColor=#000000;" edge="1" parent="1" source="merge_label" target="new_prompt">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
